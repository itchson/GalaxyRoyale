+#[test]
+fn boxed_solo_world_restores_ecs_transients_and_deterministic_continuation_after_teardown() {
+    for mode in 0..3 {
+        let mut game = boxed_world_fixture();
+        let mut reference = boxed_world_fixture();
+        let before = boxed_world_probe(&game);
+        assert_eq!(before, boxed_world_probe(&reference));
+        assert!(!game.chunks.is_empty());
+        assert_eq!(game.world.query::<&Segment>().iter().count(), 4);
+        assert_eq!(game.world.query::<&Bullet>().iter().count(), 1);
+        assert_eq!(game.world.query::<&Loot>().iter().count(), 1);
+        let mut original_render = FrameBuilder::new();
+        game.render_into(0.375, &mut original_render);
+        let original_render = format!("{:?}", original_render.frame());
+        assert_eq!(
+            game.begin_co_op("wrong", session(), host()),
+            Err(Error::InvalidProtocol)
+        );
+        assert_eq!(before, boxed_world_probe(&game));
+        game.begin_co_op(PROTOCOL, session(), host()).unwrap();
+        let a = guest(&mut game, 2);
+        assert_eq!(game.join_co_op(session(), spec(2)), Err(Error::DuplicateId));
+        place(&mut game, host(), Vec2::new(450.0, 0.0), 0.0);
+        for sequence in 0..30 {
+            game.submit_host_co_op_input(
+                session(),
+                sequence,
+                InputFrame {
+                    fire: true,
+                    joystick: Some([1.0, 0.0]),
+                    ..Default::default()
+                },
+            )
+            .unwrap();
+            game.tick_co_op(session()).unwrap();
+        }
+        game.acquire_co_op_publication(session()).unwrap();
+        let generation = game.publication_generation;
+        assert!(generation > 0);
+        assert!(game.publication.is_some());
+        assert_ne!(game.rng, game.co_op.as_ref().unwrap().solo.rng);
+        game.wake.clear();
+        game.particles.clear();
+        game.camera = Vec2::splat(999.0);
+        game.world
+            .get::<&mut PixelBody>(game.player)
+            .unwrap()
+            .damage(Vec2::ZERO, 100.0);
+        assert_eq!(game.end_co_op(id(2000)), Err(Error::StaleSession));
+        game.leave_co_op(session(), a.id, a.epoch).unwrap();
+        assert!(game.co_op_session().is_some());
+        assert_eq!(
+            before,
+            boxed_world_probe(&game.co_op.as_ref().unwrap().solo)
+        );
+        assert_eq!(
+            game.leave_co_op(session(), a.id, a.epoch),
+            Err(Error::StaleMembership)
+        );
+        match mode {
+            0 => game.end_co_op(session()).unwrap(),
+            1 => game.leave_co_op(session(), host(), 1).unwrap(),
+            _ => game.reset_to_dock(),
+        }
+        assert!(game.co_op_session().is_none());
+        assert!(game.publication.is_none());
+        // Acquisition IDs must never be reused after returning to the old world.
+        assert_eq!(game.publication_generation, generation);
+        assert_eq!(before, boxed_world_probe(&game));
+        let mut restored_render = FrameBuilder::new();
+        game.render_into(0.375, &mut restored_render);
+        assert_eq!(original_render, format!("{:?}", restored_render.frame()));
+        game.move_player(Vec2::new(300.0, 110.0));
+        reference.move_player(Vec2::new(300.0, 110.0));
+        for sequence in 0..90 {
+            let input = InputFrame {
+                fire: sequence % 3 == 0,
+                joystick: Some([1.0, 0.2]),
+                ..Default::default()
+            };
+            game.tick(&input, 1.0 / 60.0);
+            reference.tick(&input, 1.0 / 60.0);
+            assert_eq!(game.random().to_bits(), reference.random().to_bits());
+            assert_eq!(
+                serde_json::to_value(game.hud()).unwrap(),
+                serde_json::to_value(reference.hud()).unwrap()
+            );
+        }
+        assert_eq!(boxed_world_probe(&game), boxed_world_probe(&reference));
+        assert!(game.events.iter().any(|event| event.kind == "ability-wake"));
+        assert!(!game.wake.is_empty());
+    }
+}
