+    game.wake_timer = 0.067;
+    game.exhaust_timer = 0.031;
+    game.trail_timer = 0.047;
+    game.since_damage = 1.25;
+    game.invulnerability = 0.17;
+    game.spawn_timer = 0.43;
+    game.boss_timer = 7.5;
+    game.kill_credit = [3, 5, 8];
