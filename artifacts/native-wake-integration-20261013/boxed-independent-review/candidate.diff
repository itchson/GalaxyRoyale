+// Semantic state, not struct bytes/padding or a serialized Profile. This fixture
+// includes every basic component it creates and the solo transient fields that
+// can affect continuation. Publication generation is deliberately checked apart.
+fn boxed_world_probe(game: &Game) -> serde_json::Value {
+    use serde_json::json;
+    let mut entities: Vec<_> = game
+        .world
+        .query::<(
+            Entity,
+            Option<&Motion>,
+            Option<&Actor>,
+            Option<&PixelBody>,
+            Option<&Brain>,
+            Option<&Segment>,
+            Option<&Bullet>,
+            Option<&Loot>,
+            Option<&AsteroidBirth>,
+        )>()
+        .iter()
+        .map(
+            |(e, motion, actor, body, brain, segment, bullet, loot, birth)| {
+                (
+                    e.to_bits().get(),
+                    json!({
+                        "motion": motion.map(|m| (m.position.to_array(), m.previous.to_array(),
+                            m.velocity.to_array(), m.heading, m.previous_heading)),
+                        "actor": actor.map(|a| (format!("{:?}", a.kind), a.health, a.max_health,
+                            a.radius, a.scale, a.damage)),
+                        "body": body.map(|b| format!("{b:?}")),
+                        "brain": brain.map(|b| (b.family, b.boss, b.age, b.shot_timer, b.phase)),
+                        "segment": segment.map(|s| (s.owner.to_bits().get(), s.index, s.health,
+                            s.scale, s.radius, s.front.to_array(), s.rear.to_array(), s.attached)),
+                        "bullet": bullet.map(|b| (b.player, b.damage, b.life, b.remaining_hits,
+                            b.previous_hit.map(|e| e.to_bits().get()))),
+                        "loot": loot.map(|l| (l.category, l.material_tier, l.training_material,
+                            l.amount, l.life)),
+                        "birth": birth.map(|b| format!("{b:?}")),
+                    }),
+                )
+            },
+        )
+        .collect();
+    entities.sort_by_key(|(id, _)| *id);
+    let mut chunks: Vec<_> = game
+        .chunks
+        .iter()
+        .map(|(key, entities)| {
+            (
+                *key,
+                entities
+                    .iter()
+                    .map(|e| e.to_bits().get())
+                    .collect::<Vec<_>>(),
+            )
+        })
+        .collect();
+    chunks.sort_by_key(|(key, _)| *key);
+    let particles: Vec<_> = game
+        .particles
+        .iter()
+        .map(|p| {
+            json!([
+                p.position.to_array(),
+                p.origin.to_array(),
+                p.local.to_array(),
+                p.previous_local.to_array(),
+                p.velocity.to_array(),
+                p.acceleration.to_array(),
+                p.life,
+                p.initial_life,
+                p.color,
+                p.size,
+                p.seed,
+                format!("{:?}", p.style),
+            ])
+        })
+        .collect();
+    let lights: Vec<_> = game
+        .transient_lights
+        .iter()
+        .map(|l| (&l.source, l.life, l.initial_life))
+        .collect();
+    json!({
+        "player": game.player.to_bits().get(), "entities": entities, "chunks": chunks,
+        "profile": game.profile, "hud": game.hud(), "events": game.events,
+        "camera": [game.camera.to_array(), game.previous_camera.to_array()],
+        "clock": [game.time, game.expedition],
+        "controls": (game.paused, game.throttle, game.destination.map(|p| p.to_array())),
+        "combat": (game.fire_timer, game.shot_count, game.shield, game.since_damage,
+            game.invulnerability, game.repulsor_timer, game.wake_timer, game.exhaust_timer,
+            game.spawn_timer, game.boss_timer, game.kill_credit, game.was_safe),
+        "active_boss": game.active_boss.map(|e| e.to_bits().get()),
+        "cosmetics": (game.shake, game.rng, game.cosmetic_sequence, game.trail_timer,
+            game.reduced_cosmetics, game.reduced_motion),
+        "particles": particles, "lights": lights,
+        "wake": game.wake.iter().map(|(p, life)| (p.to_array(), *life)).collect::<Vec<_>>(),
+        "dock": format!("{:?}", game.dock_body), "viewport": game.viewport.to_array(),
+        "regions": (&game.nearby_sites, game.site_grid), "run": game.run,
+        "flags": (game.stress_mode, game.boss_qa_scene, game.diagnostic_scene, game.material_scene),
+        "loss": (game.material_loss, &game.material_loss_reason),
+    })
+}
