+    step: () => {
+      throw Error("declared native step failure");
+    },
+    update: () => {},
+    role: "guest",
+    controller: { state: () => ({ phase: "ended" }), frameMode: () => "solo" },
+    transport: null,
+    mode: "solo",
+    counters: {},
+    profileEqual: true,
+    persistedEqual: true,
+    persistent: true,
+    progressionFalse: true,
+    movementObserved: false,
+    profileSha: null,
+    baseline: null,
+    persistedSha: null,
+    config: { profile_mode: "starter" },
+    scenario: "default",
+  });
+  for (const name of ["schedule", "observations"])
+    vm.runInContext(declaration("child", name), child);
+  let created = false,
+    cleaned = 0;
+  const room = (role) => ({
+    mode: created && role === "host" ? "host" : "solo",
+    life_ms: 180000,
+    created: 0,
+    closed: 0,
+    requests: 0,
+    timers: 0,
+    phase: "ended",
+    reason: "join_declined",
+    awaiting: false,
+    pending: 0,
+    ready: 0,
+    admitted: 0,
+    same_room: true,
+    same_native: true,
+    same_peers: true,
+  });
+  const context = vm.createContext({
+    requireVisibleClients: () => {},
+    initialized: true,
+    scenario: "default",
+    config: { profile_mode: "owned" },
+    roomCases: new Set(),
+    roomAttempted: false,
+    driveActive: false,
+    driveVisibilityLost: false,
+    performance: { now: () => 10 },
+    roomSend: async (role, name) => {
+      if (name === "create") {
+        created = true;
+        return { invite: "private" };
+      }
+      return name === "state" ? child.observations() : room(role);
+    },
+    roomMarkBoth: async () => {},
+    roomPending: async () => {
+      child.schedule();
+      callback();
+    },
+    roomFinish: async () => {
+      assert.equal(context.driveActive, false);
+      cleaned++;
+    },
+    check: (name, passed) => assert(passed, name),
+  });
+  for (const name of [
+    "guardDriveVisibility",
+    "roomRead",
+    "roomUntil",
+    "roomTerminal",
