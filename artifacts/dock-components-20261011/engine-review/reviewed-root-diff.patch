+test("component workshop reveals only discovered recipes and delegates exact authoritative actions", () => {
+  const f = fixture(),
+    data = hud();
+  f.exports.paintForge(f.target, data, f.actions);
+  assert.equal(f.find("browse-components"), undefined);
+  data.components = [
