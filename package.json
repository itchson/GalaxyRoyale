{
  "name": "galaxy-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:game": "vite --config apps/game/vite.config.ts",
    "dev:studio": "node apps/studio/server.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "vite build --config apps/game/vite.config.ts",
    "build:studio": "vite build --config apps/studio/vite.config.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test apps/studio/test/*.test.mjs scripts/test/*.test.mjs",
    "studio": "node scripts/studio-cli.mjs",
    "format": "prettier --write apps/game/src apps/game/index.html scripts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
